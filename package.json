{
  "name": "conventional-comments-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/adapters/shared",
    "packages/adapters/github",
    "packages/adapters/azdo",
    "packages/extension",
    "packages/server"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/adapters/shared packages/adapters/github packages/adapters/azdo packages/server packages/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force packages/core packages/adapters/shared packages/adapters/github packages/adapters/azdo packages/server packages/extension",
    "spike": "node spikes/p1-prime/run.mjs",
    "check:github-theme-vars": "node scripts/check-github-theme-vars.mjs",
    "build:extension": "node packages/extension/build.mjs",
    "check:ca-matrix": "node scripts/check-ca-matrix.mjs",
    "check:invisible": "node scripts/check-invisible-chars.mjs",
    "checks": "npm run check:ca-matrix && npm run check:invisible",
    "server": "node packages/server/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.6",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
