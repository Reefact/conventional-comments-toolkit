      "properties": {
        "floorVersion": { "type": "integer" },
        "configUrl": { "type": "string" },
        "minimumMode": { "type": "string", "enum": ["off", "assist", "warn", "enforce"] },
        "formatSeverity": { "type": "string", "enum": ["warn", "error"] },
        "severities": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["off", "warn", "error"] }
        },
        "labels": {
          "type": "object",
          "properties": {
            "minimum": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rules": {
